# ============================================================
# JARVIS Cloud — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# Run: cp .env.example .env
# Then edit .env with your real credentials.
#
# NEVER commit the real .env to git — it's protected by .gitignore.
# ============================================================

# ===== CUSTOMER IDENTITY =====
# Your name as JARVIS will refer to you in logs and outputs.
OWNER_NAME=YourFirstName

# How JARVIS addresses you. Common: Boss, Sir, Ma'am, Captain.
OWNER_TITLE=Boss

# Your timezone (IANA format).
# Common: America/Chicago, America/New_York, America/Los_Angeles, America/Denver
TIMEZONE=America/Chicago

# Your city (for weather and briefings).
LOCATION_CITY=Bullard, TX

# Coordinates for weather lookups.
# Find yours: https://www.latlong.net/
LOCATION_LAT=32.1374
LOCATION_LON=-95.3294

# ===== ENVIRONMENT =====
# 'development' on your local Mac, 'production' on Railway.
ENVIRONMENT=development
DEBUG=true

# ===== JARVIS API AUTH =====
# A random 32+ character key. JARVIS requires this in the X-API-Key header
# for all requests. Generate one with: openssl rand -hex 32
JARVIS_API_KEY=replace-with-random-32-plus-character-string

# Server bind settings (defaults are fine for most setups).
JARVIS_API_HOST=0.0.0.0
JARVIS_API_PORT=5001

# ===== ANTHROPIC (CLAUDE) =====
# Get from https://console.anthropic.com/
# Format: sk-ant-...
ANTHROPIC_API_KEY=sk-ant-replace-with-your-real-key

# Models for the 3-layer routing system.
CLAUDE_MODEL_DEFAULT=claude-haiku-4-5-20251001
CLAUDE_MODEL_COMPLEX=claude-sonnet-4-5

# ===== GOOGLE (CALENDAR, TASKS, GMAIL) =====
# Path to Google OAuth credentials.json (downloaded from Google Cloud Console).
GOOGLE_CREDENTIALS_PATH=credentials.json

# Path where the OAuth token will be saved after first authorization.
GOOGLE_TOKEN_PATH=google_token.json

# ===== WEATHER (OPTIONAL) =====
# Get a free key at https://openweathermap.org/api
# Leave blank to disable weather features.
OPENWEATHER_API_KEY=

# ===== LOGGING =====
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_DIR=logs
