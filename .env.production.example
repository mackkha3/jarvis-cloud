# ============================================================
#  J.A.R.V.I.S Cloud — Production Environment Template
#  Copy this to Railway's environment variables dashboard.
#  Every variable marked REQUIRED must be set before deploying.
# ============================================================


# ── WHO IS JARVIS SERVING? ───────────────────────────────────
# Your first name — JARVIS uses this in every briefing.
# Example: Mike, Sarah, Tony
OWNER_NAME=                            # REQUIRED

# How JARVIS addresses you (optional, defaults to "Boss")
OWNER_TITLE=Boss

# Your timezone — full IANA format. Must be exact.
# Find yours at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: America/New_York  America/Chicago  America/Los_Angeles  Europe/London
TIMEZONE=America/Chicago

# Your city name — used in briefings for context (optional)
LOCATION_CITY=

# Latitude and longitude — used for weather (optional, set both or neither)
LOCATION_LAT=0.0
LOCATION_LON=0.0


# ── JARVIS AUTHENTICATION ────────────────────────────────────
# A secret key that protects your JARVIS dashboard.
# Generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
# Keep this private — treat it like a password.
JARVIS_API_KEY=                        # REQUIRED (min 16 characters)


# ── ANTHROPIC / CLAUDE ───────────────────────────────────────
# Your Claude API key from https://console.anthropic.com/
# Starts with: sk-ant-
ANTHROPIC_API_KEY=                     # REQUIRED

# Claude models — defaults are good, only change if you need to
CLAUDE_MODEL_DEFAULT=claude-haiku-4-5-20251001
CLAUDE_MODEL_COMPLEX=claude-sonnet-4-5


# ── GOOGLE INTEGRATIONS ──────────────────────────────────────
# Your Google OAuth token encoded as base64.
# DO NOT paste your raw token.json file here.
# The setup.sh script generates this value for you automatically.
# Paste the output from: base64 -i google_token.json  (Mac)
#                     or: base64 -w 0 google_token.json  (Linux)
GOOGLE_TOKEN_JSON=                     # REQUIRED for Calendar, Tasks, Gmail


# ── WEATHER (OPTIONAL) ───────────────────────────────────────
# Free API key from https://openweathermap.org/api
# Leave blank to disable weather in briefings.
OPENWEATHER_API_KEY=


# ── RUNTIME ─────────────────────────────────────────────────
# These are set automatically by Railway — do not change them
# unless Railway support specifically asks you to.
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# PORT is set automatically by Railway. Do not override this.
# PORT=8080
